# 多AI提供商配置
[[ai_providers]]
name = "deepseek"
provider = "openai"
base_url = "https://api.deepseek.com/v1"
api_key = "sk-606b34c5dcce476aaf85314d0b8c38fa"
model = "deepseek-v4-flash"
max_tokens = 4096
temperature = 0.7
is_default = true
# 思考模式配置（适用于支持思考模式的AI模型）
thinking_config = { enabled = true, effort = "high" }

[[ai_providers]]
name = "siliconflow-Qwen3.5-4B"
provider = "openai"
base_url = "https://api.siliconflow.cn/v1"
api_key = "sk-xaslayhorfsiemfizeohplhjxksyfnphopamzqkukktchgcu"
model = "Qwen/Qwen3.5-4B"
is_default = false


# 多MCP服务器配置
[[mcp_servers]]
name = "playwright"
server_command = "npx"
server_args = ["@playwright/mcp@latest"]
transport = "stdio"
timeout_secs = 30
max_retries = 3
is_default = true
categories = ["Browser"]

# 可以添加更多MCP服务器
# [[mcp_servers]]
# name = "filesystem"
# server_command = "npx"
# server_args = ["@modelcontextprotocol/server-filesystem", "/home/user"]
# transport = "stdio"
# is_default = false

# [[mcp_servers]]
# name = "github"
# server_command = "npx"
# server_args = ["@modelcontextprotocol/server-github"]
# transport = "stdio"
# is_default = false

# Prompt管理器配置
[prompt_manager]
prompt_dir = "./prompts"

[prompt_manager.template_engine]
auto_reload = true

[prompt_manager.cache]
enabled = true
max_size = 1000
ttl_seconds = 3600

[logging]
level = "info"
format = "pretty"

# 计划器配置
[planner]
# 粗粒度计划生成配置
[planner.coarse]
temperature = 0.3
max_steps = 10

# 详细步骤分析配置
[planner.detailed]
# 工具探索配置
max_tools_to_explore = 10
min_relevance_score = 0.3

# 分类过滤配置
[planner.detailed.category_filter]
# 是否启用分类过滤
enabled = true
# 分类过滤后工具少于此数量时回退到全部工具
fallback_threshold = 3
# 没有分类时最多使用的工具数量
max_tools_without_category = 20

# 风险评估配置
[planner.detailed.risk]
default_risk_level = "medium"
enable_risk_mitigation = true

# 执行策略配置
[planner.detailed.strategy]
default_timeout_ms = 30000
default_retry_count = 3

# 轨迹记忆系统配置
[trace]
# 是否启用轨迹记录
enabled = false
# 轨迹存储目录
storage_dir = "./traces"
# 入库质量门槛：迭代次数超过此值的轨迹不入库
max_iterations_for_record = 5
# 是否使用 LLM 泛化（关闭则仅规则泛化兜底）
use_llm_generalization = true
# 泛化使用的模型名称（对应 [[ai_providers]].name，为空则用默认 AI 提供商）
generalization_model = "siliconflow-Qwen3.5-4B"

# ═══════════════════════════════════════════════════════════
# RAG 向量检索配置（独立模块，非 trace 子模块）
# ═══════════════════════════════════════════════════════════
[rag]
# Embedding 提供商: "openai"（后续扩展 "onnx"）
embedding_provider = "openai"
embedding_model = "siliconflow-BAAI/bge-m3"
embedding_base_url = "https://api.siliconflow.cn/v1"
embedding_api_key = "sk-xaslayhorfsiemfizeohplhjxksyfnphopamzqkukktchgcu"

# 向量存储
[rag.store]
# 存储路径（PolarisDB 数据目录）
path = "./traces/vector_store"

# 检索配置
[rag.retrieval]
# 默认返回数量
top_k = 5
# 相似度最低门槛（0~1）
similarity_threshold = 0.7
